name: TypeTopology
include: source
flags: --without-K
       --auto-inline
       --exact-split
       --keep-pattern-variables
       --level-universe
       --no-cohesion
       --no-cumulativity
       --no-erasure
       --no-experimental-irrelevance
       --no-guardedness
       --no-infer-absurd-clauses
       --no-irrelevant-projections
       --no-print-pattern-synonyms
       --no-prop
       --no-rewriting
       --no-save-metas
       --no-sized-types
       --no-two-level
